{
  "name": "@kirocrew/usage-lens-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test:backend": "python3 -m unittest discover -s tests -q",
    "check": "npm run typecheck && npm run build && npm test",
    "test:ui": "python3 tests/fixture.py && node --test tests/frontend.test.mjs",
    "test": "npm run test:backend && npm run test:ui",
    "preview": "python3 tools/demo_payload.py && node scripts/preview.mjs --serve",
    "build:preview": "python3 tools/demo_payload.py && node scripts/preview.mjs"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "esbuild": "0.25.12",
    "typescript": "5.6.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
