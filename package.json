    "test:ui": "python3 test/fixture.py && node test/render.mjs"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "esbuild": "0.25.12",
    "typescript": "5.6.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
